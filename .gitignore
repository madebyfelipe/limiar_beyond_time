# Godot-generated imports and editor state.
/.godot/
/export_credentials.cfg
__pycache__/
*.pyc

# Local tools, validation evidence, and exported builds.
/.tools/*
!/.tools/.gdignore
/.local/*
!/.local/.gdignore
/builds/*
!/builds/.gdignore

# Operating-system metadata.
Thumbs.db
Desktop.ini
.DS_Store
